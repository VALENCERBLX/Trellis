--!nonstrict
-- Trellis
-- scripts/build-dist.luau
-- Valence
--
-- Regenerates dist/Adeal.luau from src/. Run it before tagging a release, or the
-- installer ships whatever the source looked like last time somebody remembered.
--
--   lune run scripts/build-dist
--
-- Adeal carries every module inline, so installing needs no Wally, no rojo and no
-- HTTP: paste it into the command bar and it rebuilds ReplicatedStorage.Trellis.

local fs = require("@lune/fs")

local SRC = "../src"
local OUT = "../dist/Adeal.luau"

-- Long-bracket strings nest, so a source containing ]] or ]==] needs a level the
-- source itself does not use. Find the shortest one that is safe.
local function bracketLevel(source: string): string
	for level = 0, 20 do
		local eq = string.rep("=", level)
		if not string.find(source, "]" .. eq .. "]", 1, true) and not string.find(source, "[" .. eq .. "[", 1, true) then
			return eq
		end
	end
	error("no safe long-bracket level for a source file")
end

local function quoted(source: string): string
	local eq = bracketLevel(source)
	-- A leading newline after the opening bracket is swallowed by Luau, so add one
	-- to keep line numbers matching the original file.
	return "[" .. eq .. "[\n" .. source .. "]" .. eq .. "]"
end

-- ==================================================================== gather ===

local names = {}
for _, file in fs.readDir(SRC) do
	local name = string.match(file, "^(.+)%.luau$")
	if name and name ~= "init" then
		table.insert(names, name)
	end
end
table.sort(names)

local root = fs.readFile(SRC .. "/init.luau")

local version = string.match(fs.readFile("../wally.toml"), 'version%s*=%s*"([^"]+)"') or "0.0.0"

-- ===================================================================== emit ===

local out = {}
local function w(line: string)
	table.insert(out, line)
end

w("-- Trellis " .. version)
w("-- dist/Adeal.luau")
w("-- Valence")
w("--")
w("-- GENERATED by `lune run scripts/build-dist`. Do not edit; edit src/ and rerun.")
w("--")
w("-- Paste into the Studio command bar. Rebuilds ReplicatedStorage.Trellis from the")
w("-- source carried below. Nothing else in your place is touched.")
w("--")
w("-- Over HTTP instead (Game Settings > Security > Allow HTTP Requests):")
w("--")
w('--   local h = game:GetService("HttpService")')
w('--   loadstring(h:GetAsync("https://raw.githubusercontent.com/VALENCERBLX/Trellis/master/dist/Adeal.luau"))()')
w("--")
w("-- To lay out a project around it afterwards, run dist/Setup.luau.")
w("")
w('local VERSION = "' .. version .. '"')
w("")
w("local ROOT = " .. quoted(root))
w("")
w("local MODULES = {")
for _, name in names do
	local source = fs.readFile(SRC .. "/" .. name .. ".luau")
	w('\t{ Name = "' .. name .. '", Source = ' .. quoted(source) .. " },")
end
w("}")
w("")
w([[
-- ===================================================================== install ===

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local previous = ReplicatedStorage:FindFirstChild("Trellis")
local replacing = previous ~= nil
if previous then
	previous:Destroy()
end

local package = Instance.new("ModuleScript")
package.Name = "Trellis"
package.Source = ROOT

for _, entry in MODULES do
	local child = Instance.new("ModuleScript")
	child.Name = entry.Name
	child.Source = entry.Source
	child.Parent = package
end

package.Parent = ReplicatedStorage

print(string.format(
	"[Adeal] %s ReplicatedStorage.Trellis %s (%d modules)",
	replacing and "replaced" or "installed",
	VERSION,
	#MODULES
))
print("[Adeal] next: run dist/Setup.luau to lay out a project around it")
]])

fs.writeFile(OUT, table.concat(out, "\n") .. "\n")

local size = #fs.readFile(OUT)
print(string.format("wrote %s", OUT))
print(string.format("  %d modules + init, %.0f KB", #names, size / 1024))
