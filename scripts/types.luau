--!nonstrict
-- Trellis
-- scripts/types.luau
-- Plinko Labs
--
-- The getters are DERIVED from your hierarchy, so Luau cannot know them. This walks
-- the same tree Registry does and emits a type file that does -- so :GetService(
-- offers your real Service names, and a typo is a type error rather than a runtime
-- one.
--
--   lune run scripts/types -- src/ReplicatedStorage/Shared/Modules src/ServerStorage
--   lune run scripts/types -- src/... --out src/Shared/Modules/Config/Generated.luau
--
-- Run it whenever you add or rename a module. It is the one piece of ceremony the
-- derived-getter design costs; everything else about it is free.

local fs = require("@lune/fs")
local process = require("@lune/process")

-- Same rules as Registry:singular, kept in step by hand because this runs outside
-- Roblox and cannot require the runtime module.
local PLURAL_RULES = {
	{ "ies$", "y" },
	{ "ches$", "ch" },
	{ "shes$", "sh" },
	{ "xes$", "x" },
	{ "([^s])s$", "%1" },
}

local function singular(name: string): string
	for _, rule in PLURAL_RULES do
		local out, hits = string.gsub(name, rule[1], rule[2])
		if hits > 0 then
			return out
		end
	end
	return name
end

local function isModule(path: string, name: string): string?
	if fs.isFile(path) then
		local base = string.match(name, "^(.+)%.luau?$")
		if base and base ~= "init" then
			return base
		end
		return nil
	end
	-- a folder is a module when it holds an init
	if fs.isDir(path) then
		for _, child in fs.readDir(path) do
			if child == "init.luau" or child == "init.lua" then
				return name
			end
		end
	end
	return nil
end

-- ==================================================================== the walk ===

local roots, out = {}, nil
local args = process.args
local i = 1
while i <= #args do
	if args[i] == "--" then
		i += 1 -- lune passes the separator through; it is not a root
	elseif args[i] == "--out" then
		out = args[i + 1]
		i += 2
	else
		table.insert(roots, args[i])
		i += 1
	end
end

if #roots == 0 then
	print("usage: lune run scripts/types -- <root dir>... [--out FILE]")
	print("  roots are the same folders you pass to Configure's Hierarchy")
	process.exit(1)
end

-- bin -> { container = "Packages", names = { "Lume", ... } }
local bins = {}
local total = 0

for _, root in roots do
	if not fs.isDir(root) then
		print(string.format("  ! %s is not a directory, skipping", root))
		continue
	end

	for _, container in fs.readDir(root) do
		local containerPath = root .. "/" .. container
		if not fs.isDir(containerPath) then
			continue
		end

		-- Only DIRECT children become bins, exactly as Registry does it -- so a
		-- package's own nested Packages folder is invisible here too.
		local bin = singular(container)
		local record = bins[bin]
		if not record then
			record = { Container = container, Names = {}, Seen = {} }
			bins[bin] = record
		end

		for _, child in fs.readDir(containerPath) do
			local name = isModule(containerPath .. "/" .. child, child)
			if name and not record.Seen[name] then
				record.Seen[name] = true
				table.insert(record.Names, name)
				total += 1

				-- the suffix-stripped alias the registry also registers
				local stripped = string.match(name, "^(.+)" .. bin .. "$")
				if stripped and #stripped > 0 and not record.Seen[stripped] then
					record.Seen[stripped] = true
					table.insert(record.Names, stripped)
				end
			end
		end
	end
end

-- ================================================================== the output ===

local sortedBins = {}
for bin in bins do
	table.insert(sortedBins, bin)
end
table.sort(sortedBins)

local lines = {
	"--!strict",
	"-- GENERATED BY `lune run scripts/types` -- do not edit by hand.",
	"--",
	"-- Declares the getters Trellis derives from your hierarchy, so :GetService(",
	"-- offers your real module names and a typo is a type error. Re-run after adding",
	"-- or renaming a module.",
	"--",
	"-- Annotate a module's Start against it:",
	"--",
	"--     local Generated = require(path.to.this.file)",
	"--     function CombatManager:Start(Src: Generated.Src) end",
	"",
	"local Trellis = require(script.Parent.Parent.Packages.Trellis)",
	"",
}

for _, bin in sortedBins do
	local record = bins[bin]
	table.sort(record.Names)

	local quoted = {}
	for _, name in record.Names do
		table.insert(quoted, string.format("%q", name))
	end

	table.insert(lines, string.format("-- %s/  (%d)", record.Container, #record.Names))
	if #quoted == 0 then
		table.insert(lines, string.format("export type %sName = never", bin))
	else
		table.insert(lines, string.format("export type %sName = %s", bin, table.concat(quoted, "\n\t| ")))
	end
	table.insert(lines, "")
end

table.insert(lines, "-- The injected context, with your hierarchy's getters spelled out.")
table.insert(lines, "export type Src = Trellis.Src & {")
for _, bin in sortedBins do
	table.insert(lines, string.format("\tGet%s: (self: any, name: %sName) -> any,", bin, bin))
	table.insert(lines, string.format("\tHas%s: (self: any, name: %sName) -> boolean,", bin, bin))
	table.insert(lines, string.format("\tList%s: (self: any) -> { %sName },", bin, bin))
end
table.insert(lines, "}")
table.insert(lines, "")
table.insert(lines, "return {}")

local text = table.concat(lines, "\n") .. "\n"

if out then
	fs.writeFile(out, text)
	print(string.format("wrote %s", out))
else
	print(text)
end

print(string.format("  %d bins, %d modules", #sortedBins, total))
for _, bin in sortedBins do
	print(string.format("    %-14s %-14s %d", bin, bins[bin].Container, #bins[bin].Names))
end
