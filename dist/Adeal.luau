	[string]: any,
}

-- ================================================================== the module ===

-- What you write. Every hook is optional except :Start on a Controller/Manager.
export type Module = {
	Req: { string }?,

	Start: ((self: any, Src: Src) -> ())?,
	Stop: ((self: any) -> ())?,
	Ready: ((self: any) -> ())?,

	Heartbeat: ((self: any, dt: number) -> ())?, -- Req "Heart"
	PlayerAdded: ((self: any, player: any) -> ())?, -- Req "Player"
	PlayerRemoving: ((self: any, player: any) -> ())?, -- Req "Player"
	TagAdded: ((self: any, instance: Instance, tag: string) -> ())?, -- Req "Tag"
	TagRemoved: ((self: any, instance: Instance, tag: string) -> ())?, -- Req "Tag"
	Fence: ((self: any, event: string, payload: any, from: any?) -> (boolean, string?))?,

	-- A double-sided Service: __Serve returns the client half, run BY the client.
	__Serve: ((self: any) -> Module)?,
	__Recip: ((self: any, served: Module) -> ())?,

	[string]: any,
}

-- ==================================================================== configure ===

export type Config = {
	Hierarchy: { Instance },

	-- Found in the Config bin by name when omitted.
	Junction: JunctionMap?,
	BootOrder: BootOrder?,
	Registers: { [string]: RegisterSpec }?,

	Inject: { [string]: any }?,
	Aliases: { [string]: string }?,

	-- Diagnostics.
	Log: (boolean | number)?, -- keep the last N events per path (true = 64)
	Panel: boolean?, -- build the live Inspect panel (client)
	Profile: boolean?, -- profile every module, not just those with Req "Profile"

	-- Persistence backend for registers declared Persist = true.
	Store: PersistBackend?,
}

export type PersistBackend = {
	Load: (key: string) -> any,
	Save: (key: string, value: any) -> (),
	Release: ((key: string) -> ())?,
}

export type App = {
	Side: Side,
	Src: Src,
	Order: { string },

	Get: (self: App, name: string) -> any,
	List: (self: App, role: string) -> { string },
	Inspect: (self: App) -> any,
	Stop: (self: App) -> (),
	Restart: (self: App) -> App,
}

return {}
]] },
}

-- ===================================================================== install ===

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function folder(parent, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = name
	created.Parent = parent
	return created
end

-- Trellis is a package, so it lives with the others. The path is created if this is
-- a fresh place; Setup fills in the rest of the layout afterwards.
local Packages = folder(folder(folder(ReplicatedStorage, "Shared"), "Modules"), "Packages")

-- Earlier versions installed at ReplicatedStorage.Trellis. Clear that too, so a
-- place upgraded from one of those does not end up with two copies and a require
-- pointing at whichever it finds first.
local stray = ReplicatedStorage:FindFirstChild("Trellis")
local migrated = stray ~= nil
if stray then
	stray:Destroy()
end

local previous = Packages:FindFirstChild("Trellis")
local replacing = previous ~= nil
if previous then
	previous:Destroy()
end

local package = Instance.new("ModuleScript")
package.Name = "Trellis"
package.Source = ROOT

for _, entry in MODULES do
	local child = Instance.new("ModuleScript")
	child.Name = entry.Name
	child.Source = entry.Source
	child.Parent = package
end

package.Parent = Packages

print(string.format(
	"[Adeal] %s %s %s (%d modules)",
	replacing and "replaced" or "installed",
	package:GetFullName(),
	VERSION,
	#MODULES
))
if migrated then
	print("[Adeal] removed the old copy at ReplicatedStorage.Trellis")
end
print("[Adeal] next: run dist/Setup.luau to lay out a project around it")

